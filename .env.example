# ============================================================================
# App Skeleton — Environment Configuration
# Copy this file to .env and adjust values for local development or production
# ============================================================================

# --- Brand & Public URLs ---
SITE_NAME=AlanGo
SITE_URL=http://localhost:3002
CORS_ALLOWED_ORIGIN=http://localhost:3002
WEB_PORT=3002

# --- HTTP Server ---
SERVER_PORT=8092
METRICS_PASSWORD=dev-metrics-password

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5436
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alango
DB_SSLMODE=disable

# --- Redis ---
REDIS_PORT=6380
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# --- Authentication (JWT & OAuth) ---
# Must be at least 32 characters
JWT_SECRET=change-me-in-production-at-least-32-chars-long
JWT_SECRET_PREVIOUS=
COOKIE_SECURE=false

# Google Sign-In (comma-separated Web / iOS / Android client IDs; optional in dev)
GOOGLE_CLIENT_IDS=

# Sign in with Apple (bundle ID(s) + optional .p8 key for token revocation on account delete)
APPLE_BUNDLE_IDS=kz.alango.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- File Uploads ---
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=http://localhost:8092/uploads

# --- Email (SMTP) — leave SMTP_HOST empty for dev mode (logs codes to console) ---
SMTP_HOST=mail.vison.kz
SMTP_PORT=465
SMTP_USERNAME=no_reply@vison.kz
SMTP_PASSWORD=@l7b92n0Z
SMTP_FROM=AlanGo <no_reply@vison.kz>

# --- Push Notifications (FCM v1 / Expo) — leave empty for dev mode ---
FIREBASE_SERVICE_ACCOUNT_PATH=
EXPO_PROJECT_ID=

# --- Mobile App Version Check (GET /api/app/version) ---
APP_LATEST_VERSION=1.0.0
APP_LATEST_BUILD=1
APP_MIN_VERSION=1.0.0
APP_MIN_BUILD=1
APP_UPDATE_URL=https://apps.apple.com
APP_UPDATE_TITLE=Доступно обновление
APP_UPDATE_MESSAGE=Обновите приложение для доступа к новым функциям и улучшениям стабильности.
