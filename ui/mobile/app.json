{
  "expo": {
    "name": "AlanGo",
    "slug": "alango",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alango",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080D0B"
    },
    "ios": {
      "bundleIdentifier": "kz.alango.app",
      "buildNumber": "4",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "AlanGo использует геолокацию для поиска ближайших спортивных комплексов и расчета расстояния до залов.",
        "NSPhotoLibraryUsageDescription": "Приложение использует доступ к галерее для загрузки фотографий профиля и площадок.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "kz.alango.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080D0B"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withUIScene",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложение использует доступ к галерее для загрузки фото.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D4BFF"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.944908121160-1bi2a5l9i76evjh6gl1m57clp62gvav8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
